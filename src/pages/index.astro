---
import Base from '../layouts/Base.astro';
---
<Base title="IMOBU — Asesoría inmobiliaria para invertir en departamentos" description="IMOBU te acompaña en todo el ciclo de inversión inmobiliaria: evaluamos tu perfil, gestionamos tu crédito hipotecario y te ayudamos a elegir el proyecto que calza contigo." og={{ title: 'IMOBU — Puede ser tu próxima gran inversión', description: 'Asesoría personalizada, gestión de crédito hipotecario y proyectos seleccionados en Santiago.', url: 'https://imobu.cl/' }} active="inicio" home cta={{ href: '#evaluacion', text: 'Agendar asesoría' }} script="index" wa="Hola IMOBU, quiero más información">
<Fragment slot="head"><script type="application/ld+json" is:inline set:html={JSON.stringify({"@context": "https://schema.org", "@type": "RealEstateAgent", "name": "IMOBU Asesoría Inmobiliaria", "url": "https://imobu.cl/", "logo": "https://imobu.cl/img/logo-imobu.png", "telephone": "+56951497482", "email": "contacto@imobu.cl", "address": {"@type": "PostalAddress", "streetAddress": "Badajoz 130", "addressLocality": "Las Condes", "addressRegion": "Región Metropolitana", "addressCountry": "CL"}, "areaServed": "Santiago de Chile", "sameAs": ["https://www.instagram.com/imobu.cl/", "https://www.facebook.com/imobuasesoria/", "https://www.linkedin.com/company/imobu/"]})} /></Fragment>
<main id="contenido">

<!-- HERO -->
<section id="inicio" class="hero wrap">
  <div class="hero__copy">
    <div class="eyebrow">· Asesoría inmobiliaria ·</div>
    <h1>Puede ser tu <span class="accent">próxima gran inversión.</span></h1>
    <p class="hero__lead">Te acompañamos en todo el ciclo de inversión: evaluamos tu perfil, gestionamos tu crédito hipotecario y te ayudamos a elegir el proyecto que calza contigo.</p>
    <div class="actions">
      <a href="evaluacion.html" class="btn btn--primary">¿Puedo invertir? Evalúame</a>
      <a href="proyectos.html" class="btn btn--outline">Ver proyectos</a>
    </div>
    <div class="checks">
      <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Gestión de crédito</span>
      <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Asesoría personalizada</span>
      <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Proyectos seleccionados</span>
    </div>
  </div>
  <div class="hero__visual">
    <figure class="hero__photo">
      <!-- Foto de stock (Unsplash). Reemplazar idealmente por foto real de clientes IMOBU. -->
      <img src="https://images.unsplash.com/photo-1758523671531-75bd8a19e63b?w=1100&q=80&auto=format&fit=crop"
           srcset="https://images.unsplash.com/photo-1758523671531-75bd8a19e63b?w=640&q=80&auto=format&fit=crop 640w, https://images.unsplash.com/photo-1758523671531-75bd8a19e63b?w=1100&q=80&auto=format&fit=crop 1100w, https://images.unsplash.com/photo-1758523671531-75bd8a19e63b?w=1600&q=80&auto=format&fit=crop 1600w"
           sizes="(max-width: 640px) 100vw, 520px"
           alt="Pareja sonriendo mientras revisa opciones en una tablet, rodeada de cajas de mudanza en su nuevo departamento">
      <div class="hero__dots" aria-hidden="true"><span></span><span></span></div>
    </figure>
    <div class="hero__card">
      <span class="tag">Oportunidad destacada</span>
      <div style="font-size: 13px; font-weight: 500; color: var(--muted); margin-top: 6px">Crescer · Santiago Centro</div>
      <div style="font-size: 20px; font-weight: 700">Proyecto Don Rafael</div>
      <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-top: 8px">
        <div><div class="price-label">Desde</div><div class="price" style="font-size: 26px">UF 2.521</div></div>
        <a href="/proyectos/don-rafael.html" class="btn btn--primary btn--sm">Ver proyecto</a>
      </div>
    </div>
  </div>
</section>

<!-- BUSCADOR -->
<section aria-label="Buscar proyectos" class="wrap" style="padding-top: 48px">
  <form class="search" id="search-form">
    <label class="field">Comuna
      <select name="comuna">
        <option value="">Todas las comunas</option>
        <option>Providencia</option>
        <option>Ñuñoa</option>
        <option>Santiago Centro</option>
      </select>
    </label>
    <label class="field">Precio UF
      <select name="precio">
        <option value="">Cualquier precio</option>
        <option value="0-3000">Hasta UF 3.000</option>
        <option value="3000-5000">UF 3.000 – 5.000</option>
        <option value="5000-99999">Sobre UF 5.000</option>
      </select>
    </label>
    <label class="field">Tipo de entrega
      <select name="entrega">
        <option value="">Todas</option>
        <option value="inmediata">Entrega inmediata</option>
        <option value="futura">Entrega futura</option>
      </select>
    </label>
    <button type="submit" class="btn btn--dark">Buscar oportunidades</button>
  </form>
</section>

<!-- SERVICIOS -->
<section id="nosotros" class="section wrap">
  <div style="max-width: 640px; margin-bottom: 40px">
    <div class="eyebrow" style="margin-bottom: 12px">Lo que hacemos por ti</div>
    <h2>Decisiones informadas, de principio a fin.</h2>
  </div>
  <div class="grid-3">
    <article class="card">
      <div class="icon-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C40C4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4.5a3.5 3.5 0 010 7M18 14c2 .8 3 2.8 3 6"/></svg></div>
      <h3>Asesoría personalizada</h3>
      <p>Entendemos tus objetivos y tu capacidad financiera antes de recomendarte cualquier proyecto.</p>
    </article>
    <article class="card">
      <div class="icon-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C40C4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 10h18M7 15h4"/></svg></div>
      <h3>Gestión de crédito hipotecario</h3>
      <p>Preparamos tus antecedentes y te acompañamos con los bancos hasta la aprobación.</p>
    </article>
    <article class="card">
      <div class="icon-circle"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C40C4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V8l8-5 8 5v13"/><path d="M9 21v-6h6v6"/></svg></div>
      <h3>Proyectos seleccionados</h3>
      <p>Trabajamos con inmobiliarias de trayectoria y te mostramos solo las opciones que calzan con tu perfil.</p>
    </article>
  </div>
</section>

<!-- CICLO -->
<section id="ciclo" class="section" style="padding-left: 24px; padding-right: 24px">
  <div class="cycle" style="max-width: 1200px; margin: 0 auto">
    <div class="split-head">
      <div style="max-width: 560px">
        <div class="eyebrow" style="margin-bottom: 12px">El ciclo de inversión IMOBU</div>
        <h2>Estamos a tu lado en cada paso.</h2>
      </div>
      <a href="evaluacion.html" class="btn btn--primary">Comenzar mi evaluación</a>
    </div>
    <ol class="steps">
      <li><span class="num num--pink">1</span><strong>Conversamos</strong><span>Conocemos tus metas y resolvemos tus dudas.</span></li>
      <li><span class="num">2</span><strong>Evaluamos tu perfil</strong><span>Renta, ahorro y complemento: sabemos hasta dónde llegar.</span></li>
      <li><span class="num">3</span><strong>Eliges tu proyecto</strong><span>Comparamos opciones y reservas la unidad.</span></li>
      <li><span class="num">4</span><strong>Gestionamos tu crédito</strong><span>Te acompañamos con el banco hasta la aprobación.</span></li>
      <li><span class="num num--pink">5</span><strong>Firmas y recibes</strong><span>Promesa, escritura y entrega de tu propiedad.</span></li>
    </ol>
  </div>
</section>

<!-- PROYECTOS -->
<section id="proyectos" class="section wrap">
  <div class="split-head">
    <div>
      <div class="eyebrow" style="margin-bottom: 12px">Oportunidades de inversión</div>
      <h2>Proyectos destacados</h2>
    </div>
    <a href="proyectos.html" class="btn btn--outline btn--sm">Ver todos los proyectos →</a>
  </div>
  <nav class="chips" aria-label="Explorar proyectos por comuna">
    <a class="chip-link" href="proyectos.html?comuna=%C3%91u%C3%B1oa">Ñuñoa</a>
    <a class="chip-link" href="proyectos.html?comuna=La%20Florida">La Florida</a>
    <a class="chip-link" href="proyectos.html?comuna=Santiago%20Centro">Santiago Centro</a>
    <a class="chip-link" href="proyectos.html?comuna=Macul">Macul</a>
    <a class="chip-link" href="proyectos.html?precio=0-3000">Hasta UF 3.000</a>
    <a class="chip-link" href="proyectos.html?entrega=inmediata">Entrega inmediata</a>
  </nav>
  <!-- Se llena con los proyectos marcados "destacado: true" en js/imobu.js -->
  <div class="projects" id="project-list"></div>
  <p class="fineprint" id="nota-dividendo"></p>
</section>

<!-- EVALUACION -->
<section id="evaluacion" class="section wrap eval">
  <div class="eval__copy">
    <div class="eyebrow">Evaluación de perfil</div>
    <h2>¿Puedo invertir? <span class="accent">Descúbrelo con nosotros.</span></h2>
    <p>Cuéntanos sobre tu situación financiera y un asesor IMOBU te contactará con las alternativas que mejor calzan con tu capacidad de pago. La evaluación no tiene costo ni compromiso.</p>
    <ul class="eval__list">
      <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Sabes cuánto crédito podrías obtener</li>
      <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Ves proyectos acordes a tu presupuesto</li>
      <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Decides con información, sin presiones</li>
    </ul>
    <div class="full-eval">
      <strong>Evaluación completa · 5 minutos</strong>
      <span>Ingresa tu renta, deudas, ahorro y complemento, y obtén al instante un pre-diagnóstico de cuánto podrías invertir. Luego un asesor revisa tu perfil.</span>
      <a href="evaluacion.html" class="btn btn--primary btn--sm">Hacer evaluación completa →</a>
    </div>
  </div>
  <div class="eval__form" id="eval-card">
    <!-- TODO: conectar este formulario al CRM o servicio de correo de IMOBU (hoy solo valida y muestra confirmación). -->
    <form id="eval-form" data-seguro novalidate style="display: contents">
      <p class="form-title">¿Prefieres que te llamemos?</p>
      <p class="fine full" style="margin-top: -10px; font-size: 14px">Déjanos tu número y un asesor te contacta en horario hábil.</p>
      <label class="field">Nombre<input type="text" name="nombre" placeholder="Tu nombre" autocomplete="name" required></label>
      <label class="field">Teléfono<input type="tel" name="telefono" placeholder="+56 9" autocomplete="tel" required></label>
      <label class="field full"><span>Correo electrónico <span class="field__opt">(opcional)</span></span><input type="email" name="email" placeholder="nombre@correo.cl" autocomplete="email"></label>
      <label class="field full">¿Qué te interesa?
        <select name="interes" required>
          <option value="">Selecciona una opción</option>
          <option>Invertir por primera vez</option>
          <option>Sumar otra propiedad a mi inversión</option>
          <option>Comprar para vivir</option>
          <option>Solo quiero información</option>
        </select>
      </label>
      <fieldset class="radios full">
        <legend>¿Cuándo te acomoda que te llamemos?</legend>
        <label><input type="radio" name="horario" value="Mañana">Mañana</label>
        <label><input type="radio" name="horario" value="Tarde">Tarde</label>
        <label><input type="radio" name="horario" value="Después de las 18 h">Después de las 18 h</label>
      </fieldset>
      <label class="check full"><input type="checkbox" name="acepto" required><span>Acepto la <a href="legal.html#privacidad">política de privacidad</a> y que IMOBU me contacte.</span></label>
      <p class="form-error full" id="form-error" role="alert" hidden>Revisa los campos marcados: nombre, teléfono, interés y la aceptación de la política de privacidad.</p>
      <button type="submit" class="btn btn--primary full">Quiero que me llamen</button>
    </form>
    <div class="success full" id="eval-success" role="status">
      <div class="icon-circle"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C40C4B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg></div>
      <h3 id="success-title">¡Gracias!</h3>
      <p>Recibimos tus datos. Un asesor IMOBU te llamará en el horario que elegiste para revisar juntos tus alternativas.</p>
      <a class="btn btn--primary btn--sm" href="evaluacion.html">Adelantar con la evaluación completa</a>
      <a class="btn btn--outline btn--sm" id="wa-followup" href="https://wa.me/56951497482" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
    </div>
  </div>
</section>

<!-- CONFIANZA -->
<section class="section wrap" aria-label="Por qué confiar en IMOBU">
  <div class="stats">
    <div><div class="stat__num" data-cfg="cifras.experiencia">+8 años</div><div class="stat__label">de experiencia en el rubro inmobiliario</div></div>
    <div><div class="stat__num" data-cfg="cifras.inversionistas">+450</div><div class="stat__label">inversionistas asesorados</div></div>
    <div><div class="stat__num" data-cfg="cifras.inmobiliarias">12</div><div class="stat__label">inmobiliarias aliadas</div></div>
  </div>
  <div class="partners">
    <span class="eyebrow">Trabajamos con</span>
    <span class="partner"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#646364" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M3 20l6-12 4 7 3-4 5 9z"/></svg>Surmonte</span>
    <span class="partner"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#646364" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 20h4V13H4zM10 20h4V8h-4zM16 20h4V4h-4z"/></svg>Crescer</span>
    <span class="partner"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#646364" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V9l8-6 8 6v12z"/><path d="M9 21v-7h6v7"/></svg>Fuenzalida</span>
    <span class="partners__more">y otras inmobiliarias de trayectoria</span>
  </div>
</section>

<!-- TESTIMONIOS -->
<!-- OJO: testimonios de ejemplo. Reemplazar por testimonios reales (con autorización) antes de publicar. -->
<section class="section wrap">
  <div class="eyebrow" style="margin-bottom: 12px">Historias de clientes</div>
  <h2 style="margin-bottom: 40px">Personas que ya invirtieron con IMOBU</h2>
  <div class="grid-3">
    <figure class="quote">
      <svg width="32" height="24" viewBox="0 0 32 24" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#DC0E54"/><circle cx="24" cy="8" r="7" fill="#DC0E54"/></svg>
      <blockquote>Pensaba que con mi sueldo no me alcanzaba para invertir. En IMOBU me explicaron cómo complementar renta con mi pareja y hoy tenemos nuestro primer departamento.</blockquote>
      <figcaption><span class="avatar" aria-hidden="true">DR</span><span><strong>Daniela R.</strong>Proyecto Don Rafael, Santiago Centro</span></figcaption>
    </figure>
    <figure class="quote">
      <svg width="32" height="24" viewBox="0 0 32 24" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#DC0E54"/><circle cx="24" cy="8" r="7" fill="#DC0E54"/></svg>
      <blockquote>Me ordenaron todos los papeles para el banco y me acompañaron hasta la firma de la escritura. Un proceso que creía complicado fue mucho más simple de lo que esperaba.</blockquote>
      <figcaption><span class="avatar" aria-hidden="true">FM</span><span><strong>Felipe M.</strong>Proyecto Ñuñoa 2024, Ñuñoa</span></figcaption>
    </figure>
    <figure class="quote">
      <svg width="32" height="24" viewBox="0 0 32 24" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#DC0E54"/><circle cx="24" cy="8" r="7" fill="#DC0E54"/></svg>
      <blockquote>Lo que más valoro es que nunca nos presionaron. Comparamos varias opciones con números claros y elegimos con total tranquilidad.</blockquote>
      <figcaption><span class="avatar" aria-hidden="true">CM</span><span><strong>Carolina y Matías</strong>Proyecto Linares42, Providencia</span></figcaption>
    </figure>
  </div>
</section>

<!-- CTA FINAL -->
<section class="section" style="padding-left: 24px; padding-right: 24px; padding-bottom: 112px">
  <div class="cta" style="max-width: 1200px; margin: 0 auto">
    <div style="max-width: 620px">
      <h2>Conversemos sobre tu próxima inversión.</h2>
      <p>Agenda una asesoría y te ayudamos a dar el primer paso con claridad.</p>
    </div>
    <div class="actions">
      <a href="#evaluacion" class="btn btn--white">Agendar asesoría</a>
      <a href="https://wa.me/56951497482?text=Hola%20IMOBU%2C%20quiero%20agendar%20una%20asesor%C3%ADa" target="_blank" rel="noopener" class="btn btn--ghost-white">Escríbenos por WhatsApp</a>
    </div>
  </div>
</section>

<!-- SÉ BROKER (banda separada del contenido para clientes) -->
<section id="se-broker" class="broker-band" aria-labelledby="titulo-se-broker">
  <div class="wrap">
    <div class="broker-band__label">Para futuros asesores</div>
  <div class="recruit">
    <figure class="recruit__media">
      <img src="https://images.unsplash.com/photo-1611095790444-1dfa35e37b52?w=900&q=80&auto=format&fit=crop" loading="lazy" alt="Asesor inmobiliario conversando con un cliente en una reunión">
      <span class="recruit__badge">Programa Brokers IMOBU</span>
    </figure>
    <div class="recruit__body">
      <div class="eyebrow">Trabaja con nosotros</div>
      <h2 id="titulo-se-broker">¿Quieres ser asesor inmobiliario? <span class="accent">Regístrate aquí.</span></h2>
      <p>Súmate a nuestra red de brokers: te capacitamos, te damos acceso a proyectos de inmobiliarias de trayectoria y nuestro equipo gestiona el crédito hipotecario de tus clientes. Tú pones las ganas y tu red de contactos.</p>
      <ul class="recruit__perks">
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Horario flexible</li>
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V6l8-3 8 3v13"/><path d="M9 21v-6h6v6"/></svg>Capacitación sin costo</li>
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC0E54" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M17 7H9.5a3 3 0 000 6h5a3 3 0 010 6H6"/></svg>Comisión por cada venta</li>
      </ul>
      <div class="actions">
        <a href="broker.html#postula" class="btn btn--primary">Regístrate aquí</a>
        <a href="broker.html" class="btn btn--outline">Conoce el programa</a>
      </div>
    </div>
  </div>
  </div>
</section>

</main>
</Base>
