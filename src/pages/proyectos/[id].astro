---
import Base from '../../layouts/Base.astro';
import config from '../../lib/config';

export function getStaticPaths() {
  return config.proyectos.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const uf = (n: number) => 'UF ' + Math.round(n).toLocaleString('es-CL');
const foto = /^https?:\/\//.test(p.foto) ? p.foto : `https://images.unsplash.com/${p.foto}?w=1400&q=80&auto=format&fit=crop`;
const tip = (d: number[]) => { const l = (n: number) => (n === 0 ? 'Studio' : n + 'D'); return d.length === 1 ? l(d[0]) : l(d[0]) + ' a ' + l(d[d.length - 1]); };
const inmediata = p.entrega === 'inmediata';
const evalHref = '/evaluacion.html?proyecto=' + encodeURIComponent(p.nombre);
const description = `${p.nombre} en ${p.comuna}, de ${p.inmobiliaria}. Desde ${uf(p.uf)}. Simula tu dividendo y evalúa tu perfil con IMOBU.`;
---
<Base title={`${p.nombre} — ${p.comuna} | IMOBU`} description={description} og={{ title: p.nombre, url: `https://imobu.cl/proyectos/${p.id}.html`, image: foto }} active="proyectos" cta={{ href: evalHref, text: 'Evaluar mi perfil', id: 'nav-eval' }} script="proyecto" body={{ 'data-proyecto': p.id }} wa="">
<main id="contenido">

  <!-- Contenido inicial en el HTML (buscadores); js/proyecto.js lo vuelve a dibujar con dividendo y enlaces -->
  <section class="wrap" id="pdp-root" aria-live="polite">
    <div class="breadcrumb" style="padding-top: 40px"><a href="/">Inicio</a> / <a href="/proyectos.html">Proyectos</a> / {p.nombre}</div>
    <div class="pdp">
      <figure class="pdp__media">
        <img src={foto} alt={p.alt}>
        <span class:list={['badge', { 'badge--now': inmediata }]}>{inmediata ? 'Entrega inmediata' : 'Entrega futura'}</span>
      </figure>
      <div class="pdp__info">
        <div class="project__dev">{p.inmobiliaria}</div>
        <h1>{p.nombre}</h1>
        <p class="project__place" style="margin: 0">{p.comuna}</p>
        <div class="facts"><span class="fact">{tip(p.dorm)}</span><span class="fact">{p.m2}</span><span class="fact">{inmediata ? 'Entrega inmediata' : 'Entrega futura'}</span></div>
        <div class="pdp__price"><div><div class="price-label">Desde</div><div class="price">{uf(p.uf)}</div></div></div>
        <div class="pdp__actions"><a href={evalHref} class="btn btn--primary">Evaluarme para este proyecto</a></div>
      </div>
    </div>
  </section>


  <!-- SIMULADOR DE DIVIDENDO -->
  <section class="section wrap" id="simulador" hidden>
    <div style="max-width: 680px">
      <div class="eyebrow" style="margin-bottom: 12px">Simula tu dividendo</div>
      <h2>¿Cuánto pagarías al mes?</h2>
    </div>
    <div class="calc">
      <div class="sim__controls">
        <div class="range">
          <label class="range__head" for="c-precio">Precio de la unidad <span class="range__value" id="o-precio">UF 0</span></label>
          <input type="range" id="c-precio" step="50">
          <div class="range__scale" aria-hidden="true"><span id="s-min"></span><span id="s-max"></span></div>
        </div>
        <div class="range">
          <label class="range__head" for="c-pie">Pie <span class="range__value" id="o-pie">20%</span></label>
          <input type="range" id="c-pie" min="10" max="40" step="5" value="20">
          <div class="range__scale" aria-hidden="true"><span>10%</span><span>40%</span></div>
        </div>
        <fieldset class="choice-group">
          <legend>Plazo del crédito</legend>
          <div class="choices plazos">
            <label class="choice"><input type="radio" name="plazo" value="240"><span>20 años</span></label>
            <label class="choice"><input type="radio" name="plazo" value="300" checked><span>25 años</span></label>
            <label class="choice"><input type="radio" name="plazo" value="360"><span>30 años</span></label>
          </div>
        </fieldset>
      </div>
      <div class="sim__result" aria-live="polite">
        <div class="eyebrow">Dividendo mensual estimado</div>
        <div class="sim__big" id="r-div">$0</div>
        <div class="sim__uf" id="r-div-uf">UF 0</div>
        <div class="sim__row"><span>Pie</span><strong id="r-pie">UF 0</strong></div>
        <div class="sim__row"><span>Crédito hipotecario</span><strong id="r-credito">UF 0</strong></div>
        <div class="sim__row"><span>Renta líquida sugerida</span><strong id="r-renta">$0</strong></div>
        <p class="sim__note" id="r-nota"></p>
        <a href="/evaluacion.html" class="btn btn--white btn--sm" id="r-eval" style="align-self: flex-start">¿Califico? Evaluar mi perfil</a>
      </div>
    </div>
  </section>

  <!-- SIMILARES -->
  <section class="section wrap" id="similares" hidden>
    <div class="split-head" style="margin-bottom: 28px">
      <div>
        <div class="eyebrow" style="margin-bottom: 12px">También te puede interesar</div>
        <h2>Proyectos similares</h2>
      </div>
      <a href="/proyectos.html" class="btn btn--outline btn--sm">Ver todos los proyectos →</a>
    </div>
    <div class="projects" id="similares-list"></div>
  </section>

  <!-- CTA -->
  <section class="section" style="padding-left: 24px; padding-right: 24px; padding-bottom: 112px">
    <div class="cta" style="max-width: 1200px; margin: 0 auto">
      <div style="max-width: 620px">
        <h2>¿Quieres saber si este proyecto calza contigo?</h2>
        <p>Completa tu evaluación de perfil y un asesor IMOBU te contactará con números claros, sin compromiso.</p>
      </div>
      <div class="actions">
        <a href="/evaluacion.html" class="btn btn--white" id="cta-eval">Evaluar mi perfil</a>
        <a href="https://wa.me/56984336430" target="_blank" rel="noopener" class="btn btn--ghost-white" id="cta-wa">Hablar por WhatsApp</a>
      </div>
    </div>
  </section>

</main>
</Base>
